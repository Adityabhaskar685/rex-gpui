[Desktop Entry]
Type=Application
Name=Rex
GenericName=Terminal Multiplexer
Comment=Linux client for the Rex terminal multiplexer
Exec=rex-gpui
Icon=rex-gpui
Terminal=false
Categories=System;TerminalEmulator;
Keywords=terminal;multiplexer;rex;shell;ssh;
StartupWMClass=rex-gpui
# GPUI never answers the launch's startup notification, so with this on GNOME shows a
# busy cursor until it times out, though the window is already open.
StartupNotify=false
Actions=local;

[Desktop Action local]
Name=Open Local Server
Exec=rex-gpui -S local
